# URL API (laisser vide en prod Railway : même origine)
# En local avec Vite seul + serveur séparé, le proxy Vite /api suffit.
VITE_API_URL=

# Postgres Railway (fourni automatiquement si plugin Postgres ajouté)
DATABASE_URL=

# Port d’écoute du serveur
PORT=3000

# Optionnel : PGSSLMODE=disable pour Postgres local sans SSL
# PGSSLMODE=disable
